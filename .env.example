# ==========================================
# ExamGuard AI - Environment Configuration
# ==========================================

# Flask Secret Key for Sessions & Crypto
SECRET_KEY=examguard-super-secret-key-change-in-production-min-32-chars

# JWT Secret Key for Bearer Tokens (Must be at least 32 characters)
JWT_SECRET_KEY=examguard-jwt-secure-signing-key-32-bytes-minimum-length

# Database Configuration:
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
# Example: mysql+pymysql://root:password123@localhost:3306/examguard_db
# For SQLite: sqlite:///examguard.db (Default fallback)
DATABASE_URL=sqlite:///examguard.db

# Google Gemini API Key for AI Quiz Generation (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin for CORS Whitelisting
FRONTEND_ORIGIN=http://localhost:5173

# Biometric & Computer Vision Settings
# Threshold between 0.0 and 1.0 (Cosine Similarity). Standard recommended: 0.65 (65%)
FACE_SIMILARITY_THRESHOLD=0.65
FACE_LIVENESS_REQUIRED=true

# Proctoring Lockdown Rules
PROCTORING_WARNING_LIMIT=5
AUTO_SUBMIT_ON_VIOLATIONS=false
EVENT_COOLDOWN_SECONDS=3

# Server Port
PORT=5000
